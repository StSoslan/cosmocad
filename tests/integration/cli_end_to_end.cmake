# Сквозной сценарий консольной утилиты. Запускается как тест CTest.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run expected_code)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err ENCODING UTF8)
  if(NOT code EQUAL expected_code)
    message(FATAL_ERROR "Команда ${ARGN} вернула ${code}, ожидалось ${expected_code}\n${out}\n${err}")
  endif()
  set(last_output "${out}" PARENT_SCOPE)
endfunction()

run(0 "${CLI}" demo "${WORK}/demo.cosmocad")
run(0 "${CLI}" check "${WORK}/demo.cosmocad")
if(NOT last_output MATCHES "замечаний 0")
  message(FATAL_ERROR "В примере не должно быть замечаний:\n${last_output}")
endif()

run(0 "${CLI}" export "${WORK}/demo.cosmocad" "${WORK}/demo.svg")
run(0 "${CLI}" export "${WORK}/demo.cosmocad" "${WORK}/demo.dxf")
foreach(file demo.svg demo.dxf)
  file(SIZE "${WORK}/${file}" size)
  if(size LESS 500)
    message(FATAL_ERROR "${file} подозрительно мал: ${size} байт")
  endif()
endforeach()

# DXF читается обратно; проект без профиля даёт сбой команды проверки (код 2), а не падение.
run(0 "${CLI}" import-dxf "${WORK}/demo.dxf" "${WORK}/imported.cosmocad")
run(2 "${CLI}" check "${WORK}/imported.cosmocad")
run(2 "${CLI}" check "${WORK}/no-such-project.cosmocad")
run(2 "${CLI}" export "${WORK}/demo.cosmocad" "${WORK}/demo.xyz")
run(0 "${CLI}" profiles)
if(NOT last_output MATCHES "eskd")
  message(FATAL_ERROR "В списке профилей нет ЕСКД:\n${last_output}")
endif()
run(0 "${CLI}" plugins)
if(NOT last_output MATCHES "mass-report" OR NOT last_output MATCHES "работает")
  message(FATAL_ERROR "Пример дополнения не загрузился:\n${last_output}")
endif()
run(0 "${CLI}" library)
if(NOT last_output MATCHES "Болт М12: под ключ 18, головка 7.5" OR NOT last_output MATCHES "Гайка М12: под ключ 18, высота 10.8")
  message(FATAL_ERROR "В библиотеке крепежа нет ожидаемых размеров:\n${last_output}")
endif()
run(0 "${CLI}" pipes)
run(0 "${CLI}" pipe PP-R 1 25 6 0.6)
if(NOT last_output MATCHES "труба подходит")
  message(FATAL_ERROR "Труба PP-R 25 SDR 6 должна держать 0,6 МПа в классе 1:\n${last_output}")
endif()
run(1 "${CLI}" pipe PP-R 5 25 11 1.0)
run(2 "${CLI}" pipe PP-R 9 25 6 0.6)

# ---- 3D: пример, состояние модели, изменение параметра, экспорт ----
run(0 "${CLI}" demo3d "${WORK}/demo3d.cosmocad")
run(0 "${CLI}" model "${WORK}/demo3d.cosmocad")
if(NOT last_output MATCHES "все выполнены" OR NOT last_output MATCHES "пересечений компонентов: 0" OR last_output MATCHES "СБОЙ")
  message(FATAL_ERROR "Пример 3D должен строиться без сбоев:\n${last_output}")
endif()
run(0 "${CLI}" plugin mass-report.csv "${WORK}/demo3d.cosmocad")
if(NOT last_output MATCHES "Всего деталей: 2")
  message(FATAL_ERROR "Команда дополнения не дала ведомость:\n${last_output}")
endif()
run(2 "${CLI}" plugin mass-report.unknown "${WORK}/demo3d.cosmocad")
run(0 "${CLI}" check "${WORK}/demo3d.cosmocad")
if(NOT last_output MATCHES "замечаний 0")
  message(FATAL_ERROR "Чертёж с видами по модели не должен давать замечаний:\n${last_output}")
endif()
# Меняем длину плиты: модель, сборка и три вида на чертеже перестраиваются.
run(0 "${CLI}" set "${WORK}/demo3d.cosmocad" "Опора" "длина" "ширина * 2")
if(NOT last_output MATCHES "обновлено видов на чертежах: 3, размеров переехало: [1-9]" OR NOT last_output MATCHES "длина = ширина \\* 2 → 100")
  message(FATAL_ERROR "Параметр не применился:\n${last_output}")
endif()
# Слишком большое отверстие: бобышка не строится — код 1 и объяснение, а не падение.
run(1 "${CLI}" set "${WORK}/demo3d.cosmocad" "Опора" "диаметр" "200")
if(NOT last_output MATCHES "СБОЙ")
  message(FATAL_ERROR "Ожидалось сообщение о сбое построения:\n${last_output}")
endif()
run(0 "${CLI}" set "${WORK}/demo3d.cosmocad" "Опора" "диаметр" "24")
run(2 "${CLI}" set "${WORK}/demo3d.cosmocad" "Опора" "длина" "нет_такого + 1")
run(2 "${CLI}" set "${WORK}/demo3d.cosmocad" "Нет такой детали" "длина" "1")
run(0 "${CLI}" export-step "${WORK}/demo3d.cosmocad" "Опора" "${WORK}/support.step")
run(0 "${CLI}" export-step "${WORK}/demo3d.cosmocad" "Опора в сборе" "${WORK}/assembly.step")
run(0 "${CLI}" export-stl "${WORK}/demo3d.cosmocad" "Опора" "${WORK}/support.stl")
run(2 "${CLI}" export-step "${WORK}/demo3d.cosmocad" "Опора. Чертёж" "${WORK}/bad.step")
foreach(file support.step assembly.step support.stl)
  file(SIZE "${WORK}/${file}" size)
  if(size LESS 5000)
    message(FATAL_ERROR "${file} подозрительно мал: ${size} байт")
  endif()
endforeach()

run(0 "${CLI}" bom "${WORK}/demo3d.cosmocad" "Опора в сборе" "${WORK}/bom.csv")
file(READ "${WORK}/bom.csv" bom)
if(NOT bom MATCHES "КСМ.003.002" OR NOT bom MATCHES "Палец")
  message(FATAL_ERROR "В составе изделия нет пальца:\n${bom}")
endif()
run(2 "${CLI}" bom "${WORK}/demo3d.cosmocad" "Опора" "${WORK}/bad.csv")

# ---- Электросхемы ----
run(0 "${CLI}" demo-scheme "${WORK}/scheme.cosmocad")
run(0 "${CLI}" scheme "${WORK}/scheme.cosmocad")
if(NOT last_output MATCHES "«Выход»: C1:2 R1:2 R2:2 VD1:2" OR NOT last_output MATCHES "R1, R2 — Резистор 10 кОм, 2 шт." OR NOT last_output MATCHES "замечаний по схеме: 0")
  message(FATAL_ERROR "Пример схемы прочитан неверно:\n${last_output}")
endif()
run(0 "${CLI}" check "${WORK}/scheme.cosmocad")
run(0 "${CLI}" export "${WORK}/scheme.cosmocad" "${WORK}/scheme.dxf")
run(0 "${CLI}" scheme-list "${WORK}/scheme.cosmocad" "Фильтр. Схема" "${WORK}/elements.csv")
file(READ "${WORK}/elements.csv" elements)
if(NOT elements MATCHES "Конденсатор 0,1 мкФ")
  message(FATAL_ERROR "В перечне нет конденсатора:\n${elements}")
endif()
